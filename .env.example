# Backend
DB_URL=jdbc:postgresql://localhost:5432/rooms
DB_USER=postgres
DB_PASSWORD=
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars
FRONTEND_ORIGIN=http://localhost:5173
APP_BASE_URL=http://localhost:5173
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=rooms@rooms.local
COOKIE_SECURE=false
# Frontend
VITE_API_URL=http://localhost:8080
# Real delivery example (Gmail with an app password):
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_AUTH=true
# SMTP_STARTTLS=true
# SMTP_USERNAME=you@gmail.com
# SMTP_PASSWORD=<16 character app password>
# MAIL_FROM=you@gmail.com

# Production (profile prod)
# SPRING_PROFILES_ACTIVE=prod
# JWT_SECRET=<output of: openssl rand -hex 32>
# COOKIE_SECURE=true
# APP_BASE_URL=https://your-domain
# FRONTEND_ORIGIN=https://your-domain
# DB_URL=jdbc:postgresql://host:5432/dbname?sslmode=require
# DB_USER=...
# DB_PASSWORD=...
# ADMIN_EMAIL=you@example.com
# ADMIN_PASSWORD=<at least 12 characters, only used to create the first admin>
# ADMIN_NAME=Your name
# PORT=8080
